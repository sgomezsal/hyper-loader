# Maintainer: sgomezsal <sgomezsalazar7@gmail.com>
pkgname=hyper-loader
pkgver=0.2.0
pkgrel=1
pkgdesc="Native wlr-layer-shell overlay for masking long-running commands (nixos-rebuild, ansible, deploy scripts) on any wlroots Wayland compositor"
arch=('x86_64' 'aarch64')
url="https://github.com/sgomezsal/hyper-loader"
license=('MIT')
depends=('wayland' 'libxkbcommon')
makedepends=('cargo' 'pkgconf')
optdepends=('grim: to feed a background screenshot in via /tmp/hyper-loader-bg.png')
source=("$pkgname-$pkgver.tar.gz::https://github.com/sgomezsal/hyper-loader/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "$pkgname-$pkgver"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname-$pkgver"
  cargo test --frozen --release
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/hyper-loader "$pkgdir/usr/bin/hyper-loader"
  install -Dm644 man/hyper-loader.1 "$pkgdir/usr/share/man/man1/hyper-loader.1"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 examples/config.toml "$pkgdir/usr/share/doc/$pkgname/config.toml.example"
}
